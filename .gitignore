# 환경
.env
.venv/
venv/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# IDE
.idea/
.vscode/
.claude/settings.local.json

# 로그
logs/
logs/*.log

# DB (paper/live 영속, 사적 데이터)
data/coinbot_*.db
data/coinbot.db

# 백테 결과 — 작업용은 ignore, 보존용은 99_old/ 로 옮겨 추적
data/backtest_reports/00_Working/

# 캔들 캐시 (자동 다운로드, 크기 큼)
data/candles/*.csv

# ML 모델 아티팩트 (학습 산출물, 크기 큼)
models/

# 레짐 모델 artifact (walk-forward 사전학습 JSON, scripts/build_regime_artifacts.py 산출)
# regime_models* = 기본/변형(예: _trendonly gen1 추세-단독) 전부 untracked
data/regime_models*/

# 피처 캐시 (parquet, ML 학습 시 자동 생성)
data/features/

# 탐사/측정 산출물 (1회용 분석 결과 — 결과는 작업 보고서에 텍스트 보존)
data/*_scan/
data/*_sweep/
data/*_ablation/
# D4-4 seed 스윕 산출(s4_results.json 등, 결과는 작업보고서 D4-4)
data/s4_*

# 1회용 탐사/측정 스크립트 (규칙 8-4: commit 제외, 결과만 보고서에)
scripts/_tmp_*.py
