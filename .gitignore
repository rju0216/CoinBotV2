# 환경
.env
.venv/
venv/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# IDE
.idea/
.vscode/
.claude/settings.local.json

# 로그
logs/
logs/*.log

# DB (paper/live 영속, 사적 데이터)
data/coinbot_*.db
data/coinbot.db

# 백테 결과 — 작업용은 ignore, 보존용은 99_old/ 로 옮겨 추적
data/backtest_reports/00_Working/

# 캔들 캐시 (자동 다운로드, 크기 큼)
data/candles/*.csv

# 펀딩 이력 캐시 (자동 다운로드 — OKX 3개월 한도라 Binance 전체이력 프록시 사용, Phase5)
data/funding/*.csv

# ML 모델 아티팩트 (학습 산출물, 크기 큼)
models/
# 단, 연구 모델 소스 코드 디렉터리는 추적 (broad 'models/' 가 잡으므로 예외).
# .py 만 재포함 — __pycache__/*.pyc 는 *.pyc 규칙으로 계속 제외.
!src/research/models/
!src/research/models/*.py

# 피처 캐시 (parquet, ML 학습 시 자동 생성)
data/features/

# 탐사/측정 산출물 (1회용 분석 결과 — 결과는 작업 보고서에 텍스트 보존)
data/*_scan/
data/*_sweep/
data/*_ablation/
# 실험 러너 생성물 (ledger 등 — 재현 가능, 커밋 제외)
data/research/

# 1회용 탐사/측정 스크립트 (규칙 8-4: commit 제외, 결과만 보고서에)
scripts/_tmp_*.py
